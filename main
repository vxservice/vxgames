<script>
(() => {
  "use strict";
  const LOG = (...args) => { try { console.log("[VX Games]", ...args); } catch {} };

  // Moving VX geometric network background used by both the lock screen and the site.
  function startGeometry(id,density=13500){
    const c=document.getElementById(id),x=c&&c.getContext("2d"); if(!x)return;
    let w=0,h=0,dpr=1,pts=[],raf=0; const reduced=matchMedia("(prefers-reduced-motion: reduce)").matches;
    function reset(){dpr=Math.min(devicePixelRatio||1,2);w=innerWidth;h=innerHeight;c.width=Math.floor(w*dpr);c.height=Math.floor(h*dpr);c.style.width=w+"px";c.style.height=h+"px";x.setTransform(dpr,0,0,dpr,0,0);const n=Math.max(34,Math.min(90,Math.floor(w*h/density)));pts=Array.from({length:n},()=>({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.14,vy:(Math.random()-.5)*.14,r:Math.random()*.75+.65}));}
    function draw(){x.clearRect(0,0,w,h);for(const p of pts){if(!reduced){p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=w;if(p.x>w)p.x=0;if(p.y<0)p.y=h;if(p.y>h)p.y=0;}}for(let i=0;i<pts.length;i++)for(let j=i+1;j<pts.length;j++){const a=pts[i],b=pts[j],d=Math.hypot(a.x-b.x,a.y-b.y);if(d<145){x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.strokeStyle=`rgba(0,0,0,${(1-d/145)*.085})`;x.lineWidth=.6;x.stroke()}}for(const p of pts){x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle="rgba(0,0,0,.24)";x.fill()}if(!reduced)raf=requestAnimationFrame(draw)}
    addEventListener("resize",reset,{passive:true});reset();draw();
  }
  startGeometry("vx-bg",13500);

  const SOURCES=[
    {id:"gnmath",name:"GN-Math",owner:"gn-math",repo:"html",branch:"main"},
    {id:"hyperion",name:"Hyperion Games",owner:"stalinsky",repo:"HTML-Games",branch:"main"},
    {id:"joks",name:"Joks Games",owner:"MariasStory",repo:"htmlGames",branch:"main"}
  ];
  const GN_CATALOGS=[
    "https://raw.githubusercontent.com/gn-math/assets/main/zones.json",
    "https://cdn.jsdelivr.net/gh/gn-math/assets@main/zones.json"
  ];
  const GN_COVER_ROOTS=[
    "https://cdn.jsdelivr.net/gh/gn-math/covers@main/",
    "https://raw.githubusercontent.com/gn-math/covers/main/",
    "https://raw.githubusercontent.com/gn-math/covers/refs/heads/main/"
  ];
  const GN_HTML_ROOTS=[
    "https://raw.githubusercontent.com/gn-math/html/main/",
    "https://cdn.jsdelivr.net/gh/gn-math/html@main/"
  ];
  const GENRES=["all","Arcade","Adventure","Racing","Puzzle","Strategy","Sports","Horror","Other"];
  const HTML_RE=/\.html?$/i, IMAGE_RE=/\.(png|jpe?g|gif|webp|svg)$/i;
  let games=[],selectedProvider="all",selectedGenre="all",activeGame=null,activeBlobUrl=null,activePreparedHtml=null,activeSourceUrl=null,loadController=null;
  const $=id=>document.getElementById(id),grid=$("grid"),search=$("search"),heading=$("heading"),count=$("count"),notice=$("notice"),libraryButton=$("libraryButton"),genreButton=$("genreButton"),libraryMenu=$("libraryMenu"),genreMenu=$("genreMenu"),gameView=$("gameView"),gameFrame=$("gameFrame"),gameTitle=$("gameTitle"),gameLoading=$("gameLoading"),gameStage=$("gameStage"),downloadGame=$("downloadGame"),newTab=$("newTab");
  window.maeExportApis_=window.maeExportApis_||function(){}; window.maeImportApis_=window.maeImportApis_||function(){};

  function closeMenus(){libraryMenu.classList.remove("open");genreMenu.classList.remove("open");libraryButton.setAttribute("aria-expanded","false");genreButton.setAttribute("aria-expanded","false")}
  function toggleMenu(menu,button,other,otherButton){const open=!menu.classList.contains("open");other.classList.remove("open");otherButton.setAttribute("aria-expanded","false");menu.classList.toggle("open",open);button.setAttribute("aria-expanded",String(open))}
  libraryButton.addEventListener("click",e=>{e.stopPropagation();toggleMenu(libraryMenu,libraryButton,genreMenu,genreButton)});genreButton.addEventListener("click",e=>{e.stopPropagation();toggleMenu(genreMenu,genreButton,libraryMenu,libraryButton)});libraryMenu.addEventListener("click",e=>e.stopPropagation());genreMenu.addEventListener("click",e=>e.stopPropagation());document.addEventListener("click",closeMenus);
  function menuItem(label,value,type){const b=document.createElement("button");b.type="button";b.className="menu-item";b.textContent=label;b.dataset.value=value;b.addEventListener("click",()=>{if(type==="provider")selectedProvider=value;else selectedGenre=value;closeMenus();syncMenus();render()});return b}
  function buildMenus(){libraryMenu.querySelectorAll(".menu-item").forEach(x=>x.remove());genreMenu.querySelectorAll(".menu-item").forEach(x=>x.remove());libraryMenu.append(menuItem("All Games","all","provider"));SOURCES.forEach(s=>libraryMenu.append(menuItem(s.name,s.id,"provider")));GENRES.forEach(g=>genreMenu.append(menuItem(g==="all"?"All Genres":g,g,"genre")));syncMenus()}
  function syncMenus(){libraryMenu.querySelectorAll(".menu-item").forEach(x=>x.classList.toggle("selected",x.dataset.value===selectedProvider));genreMenu.querySelectorAll(".menu-item").forEach(x=>x.classList.toggle("selected",x.dataset.value===selectedGenre))}

  function genreOf(name,path=""){const t=(name+" "+path).toLowerCase();if(/five nights|fnaf|horror|scary|backrooms|granny|poppy|slender|amanda|doors|zombie/.test(t))return"Horror";if(/basket|football|soccer|baseball|tennis|golf|boxing|bowling|sport|volley/.test(t))return"Sports";if(/race|racing|car|drive|drift|kart|moto|bike|truck|traffic|rider|hill climb/.test(t))return"Racing";if(/platform|jump|flappy|mario|adventure|quest|escape|run|obby|vex|parkour/.test(t))return"Adventure";if(/math|quiz|word|sudoku|2048|memory|hangman|typing|puzzle|connect|merge|sort|match/.test(t))return"Puzzle";if(/chess|checkers|strategy|tower|defen[cs]e|war|battle|tycoon|idle/.test(t))return"Strategy";if(/arcade|pong|snake|breakout|tetris|space|asteroid|invader|pacman|shooter|shoot|\.io\b|ball/.test(t))return"Arcade";return"Other"}
  function dir(path){const i=path.lastIndexOf("/");return i<0?"":path.slice(0,i+1)}
  function encPath(path){return String(path).split("/").map(encodeURIComponent).join("/")}
  function titleCase(s){return String(s).replace(/\.html?$/i,"").replace(/[-_]+/g," ").replace(/\s+/g," ").trim().replace(/\b\w/g,c=>c.toUpperCase())}
  function pathName(path){const p=String(path).split("/").filter(Boolean),file=p[p.length-1]||"Game";return /^index\.html?$/i.test(file)&&p.length>1?titleCase(p[p.length-2]):titleCase(file)}
  function gnPath(url){if(typeof url!=="string")return null;const m=url.match(/^\{HTML_URL\}\/(.+?)(?:[?#].*)?$/i);if(m)return decodeURIComponent(m[1]);const m2=url.match(/(?:raw\.githubusercontent\.com\/gn-math\/html\/[^/]+\/|cdn\.jsdelivr\.net\/gh\/gn-math\/html@[^/]+\/)(.+?)(?:[?#].*)?$/i);return m2?decodeURIComponent(m2[1]):null}
  function coverFile(cover){if(typeof cover!=="string")return null;if(cover.startsWith("{COVER_URL}/"))return cover.slice(12);const m=cover.match(/(?:raw\.githubusercontent\.com\/gn-math\/covers\/[^/]+\/|cdn\.jsdelivr\.net\/gh\/gn-math\/covers@[^/]+\/)(.+?)(?:[?#].*)?$/i);return m?decodeURIComponent(m[1]):null}

  async function fetchJsonFallback(urls){let last;for(const u of urls){try{const r=await fetch(u+(u.includes("?")?"&":"?")+"vx="+Date.now(),{cache:"no-store"});if(!r.ok)throw new Error(String(r.status));return await r.json()}catch(e){last=e}}throw last||new Error("Request failed")}
  async function loadGnMath(){const data=await fetchJsonFallback(GN_CATALOGS);if(!Array.isArray(data))throw new Error("Invalid GN-Math catalog");const out=[];for(const entry of data){if(!entry||typeof entry!=="object")continue;const name=typeof entry.name==="string"?entry.name.trim():"";if(!name)continue;if(Number(entry.id)<0)continue;const url=typeof entry.url==="string"?entry.url.trim():"";if(!url)continue;const isComments=Number(entry.id)===596||/^\s*(?:\[!\]\s*)?comments?\s*$/i.test(name);const effectiveUrl=isComments?"https://forms.gle/gyAFBd1gMAAmCw1b8":url;const path=isComments?null:gnPath(effectiveUrl);const cf=coverFile(entry.cover);const coverCandidates=cf?GN_COVER_ROOTS.map(root=>root+encPath(cf)):(/^https?:\/\//i.test(entry.cover||"")?[entry.cover]:[]);out.push({id:"gnmath:"+String(entry.id),provider:"gnmath",providerName:"GN-Math",name,genre:genreOf(name,path||url),catalogId:entry.id,path,externalUrl:!path&&/^https?:\/\//i.test(effectiveUrl)?effectiveUrl:null,coverCandidates,source:SOURCES[0]})}return out}

  async function repoTree(source){const api=`https://api.github.com/repos/${encodeURIComponent(source.owner)}/${encodeURIComponent(source.repo)}/git/trees/${encodeURIComponent(source.branch)}?recursive=1`;try{const r=await fetch(api,{headers:{Accept:"application/vnd.github+json"}});if(!r.ok)throw new Error(String(r.status));const j=await r.json();if(!Array.isArray(j.tree))throw new Error("bad tree");return j.tree.filter(x=>x.type==="blob"&&x.path)}catch(e){const r=await fetch(`https://data.jsdelivr.com/v1/package/gh/${source.owner}/${source.repo}@${source.branch}/flat`);if(!r.ok)throw e;const j=await r.json();return (j.files||[]).map(x=>({path:String(x.name||"").replace(/^\/+/,""),sha:null})).filter(x=>x.path)}}
  function repoRoot(s){return`https://cdn.jsdelivr.net/gh/${s.owner}/${s.repo}@${s.branch}/`}
  function nearestImage(path,all,s){const folder=dir(path),base=path.split("/").pop().replace(/\.[^.]+$/,"").toLowerCase();let best=null,score=-1;for(const p of all){if(!IMAGE_RE.test(p))continue;let sc=0;if(dir(p)===folder)sc+=100;if(p.split("/").pop().replace(/\.[^.]+$/,"").toLowerCase()===base)sc+=75;if(/(?:cover|thumb|thumbnail|icon|logo|preview)/i.test(p))sc+=35;if(sc>score){score=sc;best=p}}return best&&score>=70?[repoRoot(s)+encPath(best)]:[]}
  async function loadGeneric(source){const tree=await repoTree(source),paths=tree.map(x=>x.path),out=[];for(const item of tree){const path=item.path;if(!HTML_RE.test(path))continue;const file=path.split("/").pop().toLowerCase();if(path.split("/").length===1&&file==="index.html")continue;const name=pathName(path);out.push({id:source.id+":"+path,provider:source.id,providerName:source.name,name,genre:genreOf(name,path),path,sha:item.sha||null,coverCandidates:nearestImage(path,paths,source),source})}return out}

  function currentHeading(){const p=selectedProvider==="all"?"All Games":(SOURCES.find(s=>s.id===selectedProvider)?.name||"Games");return selectedGenre==="all"?p:`${p} · ${selectedGenre}`}
  function makeCard(game){
    const card=document.createElement("button");card.type="button";card.className="card";card.title=game.name;card.setAttribute("aria-label","Play "+game.name);card.addEventListener("click",()=>openGame(game));
    const cover=document.createElement("div");cover.className="cover";
    const fb=document.createElement("div");fb.className="cover-fallback";cover.append(fb);
    if(game.coverCandidates&&game.coverCandidates.length){const img=document.createElement("img");img.loading="lazy";img.decoding="async";img.referrerPolicy="no-referrer";img.alt=game.name+" cover";let i=0;const next=()=>{if(i>=game.coverCandidates.length){img.remove();return}img.classList.remove("loaded");img.src=game.coverCandidates[i++]};img.addEventListener("load",()=>img.classList.add("loaded"));img.addEventListener("error",next);cover.append(img);next();if(img.complete&&img.naturalWidth)img.classList.add("loaded")}
    const info=document.createElement("div");info.className="card-info";const n=document.createElement("div");n.className="card-name";n.textContent=game.name;const g=document.createElement("div");g.className="card-genre";g.textContent=game.genre;info.append(n,g);card.append(cover,info);return card
  }
  function render(){const q=search.value.trim().toLowerCase();let list=games.filter(g=>(selectedProvider==="all"||g.provider===selectedProvider)&&(selectedGenre==="all"||g.genre===selectedGenre)&&(!q||(g.name+" "+g.genre).toLowerCase().includes(q)));list.sort((a,b)=>a.name.localeCompare(b.name,undefined,{numeric:true,sensitivity:"base"}));heading.textContent=currentHeading();count.textContent=`${list.length.toLocaleString()} ${list.length===1?"game":"games"}`;grid.replaceChildren();if(!list.length){const e=document.createElement("div");e.className="status";e.textContent=games.length?"No games match this search.":"No games could be loaded.";grid.append(e);return}const f=document.createDocumentFragment();for(const g of list)f.append(makeCard(g));grid.append(f)}
  search.addEventListener("input",render);

  async function fetchTextFallback(urls,signal){let last;for(const u of urls){try{const r=await fetch(u,{cache:"no-store",signal});if(!r.ok)throw new Error(String(r.status));return await r.text()}catch(e){if(signal&&signal.aborted)throw e;last=e}}throw last||new Error("Unable to load")}
  function genericUrls(game){const s=game.source,p=encPath(game.path);return[`https://raw.githubusercontent.com/${s.owner}/${s.repo}/${s.branch}/${p}`,`https://cdn.jsdelivr.net/gh/${s.owner}/${s.repo}@${s.branch}/${p}`]}
  function hasAbsBase(html){const m=html.match(/<base\b[^>]*href\s*=\s*(["'])(.*?)\1[^>]*>/i);return !!(m&&(/^(?:https?:)?\/\//i.test(m[2])||/^(?:data|blob):/i.test(m[2])))}
  function prepare(html,game){let root,folder;if(game.provider==="gnmath"){root=GN_HTML_ROOTS[1];folder=root+dir(game.path)}else{root=repoRoot(game.source);folder=root+dir(game.path)}const abs=hasAbsBase(html),baseRe=/<base\b[^>]*href\s*=\s*(["'])(.*?)\1[^>]*>/i,m=html.match(baseRe);if(m&&!abs){try{html=html.replace(baseRe,`<base href="${new URL(m[2],folder).href}">`)}catch{html=html.replace(baseRe,`<base href="${folder}">`)}}else if(!m){const tag=`<base href="${folder}">`;html=/<head\b[^>]*>/i.test(html)?html.replace(/<head\b[^>]*>/i,x=>x+tag):tag+html}if(!abs){html=html.replace(/(\s(?:src|href|poster|data-src)\s*=\s*["'])\/(?!\/)([^"']+)/gi,(m,a,b)=>a+root+b);html=html.replace(/url\(\s*(["']?)\/(?!\/)([^)'"\s]+)\1\s*\)/gi,(m,q,p)=>`url(${q}${root}${p}${q})`)}const shim=`<script>try{window.maeExportApis_=window.maeExportApis_||function(){};window.maeImportApis_=window.maeImportApis_||function(){}}catch(e){}<\/script>`;return /<head\b[^>]*>/i.test(html)?html.replace(/<head\b[^>]*>/i,x=>x+shim):shim+html}
  function loading(msg="Loading game..."){gameLoading.classList.add("show");gameLoading.innerHTML=`<div><div class="loader"></div><div class="game-loading-message"></div></div>`;gameLoading.querySelector(".game-loading-message").textContent=msg}
  function loadError(){gameLoading.classList.add("show");gameLoading.replaceChildren();const b=document.createElement("div");b.className="game-error";const s=document.createElement("strong");s.textContent="This game could not be loaded.";const t=document.createElement("span");t.textContent="Its source may be temporarily unavailable or it may require files that are currently offline.";b.append(s,t);gameLoading.append(b)}
  function safeFileName(name){return String(name||"game").replace(/[\/:*?"<>|]+/g,"-").replace(/\s+/g," ").trim().slice(0,90)||"game"}
  function setGameActions(enabled){downloadGame.disabled=!enabled;newTab.disabled=!enabled}
  async function openGame(game){
    if(game.provider==="gnmath"&&(Number(game.catalogId)===596||/^\s*(?:\[!\]\s*)?comments?\s*$/i.test(game.name))){window.open("https://forms.gle/gyAFBd1gMAAmCw1b8","_blank","noopener,noreferrer");return}
    activeGame=game;activePreparedHtml=null;activeSourceUrl=null;setGameActions(false);
    if(loadController)loadController.abort();loadController=new AbortController();gameTitle.textContent=game.name;gameFrame.title=game.name;gameView.classList.add("open");gameView.setAttribute("aria-hidden","false");document.body.style.overflow="hidden";loading();gameFrame.onload=null;gameFrame.src="about:blank";if(activeBlobUrl){URL.revokeObjectURL(activeBlobUrl);activeBlobUrl=null}
    try{
      if(game.externalUrl){activeSourceUrl=game.externalUrl;setGameActions(true);gameFrame.onload=()=>{if(activeGame===game)gameLoading.classList.remove("show")};gameFrame.src=game.externalUrl;return}
      const urls=game.provider==="gnmath"?GN_HTML_ROOTS.map(r=>r+encPath(game.path)):genericUrls(game);const html=await fetchTextFallback(urls,loadController.signal);if(loadController.signal.aborted||activeGame!==game)return;const prepared=prepare(html,game);activePreparedHtml=prepared;activeSourceUrl=urls[urls.length-1];setGameActions(true);activeBlobUrl=URL.createObjectURL(new Blob([prepared],{type:"text/html;charset=utf-8"}));gameFrame.onload=()=>{if(activeGame===game)gameLoading.classList.remove("show")};gameFrame.src=activeBlobUrl
    }catch(e){if(!loadController.signal.aborted)loadError()}
  }
  function closeGame(){if(loadController)loadController.abort();loadController=null;activeGame=null;activePreparedHtml=null;activeSourceUrl=null;setGameActions(false);gameView.classList.remove("open");gameView.setAttribute("aria-hidden","true");document.body.style.overflow="";gameFrame.onload=null;gameFrame.src="about:blank";if(activeBlobUrl){URL.revokeObjectURL(activeBlobUrl);activeBlobUrl=null}}
  $("closeGame").addEventListener("click",closeGame);
  $("fullscreen").addEventListener("click",async()=>{try{if(!document.fullscreenElement)await gameStage.requestFullscreen();else await document.exitFullscreen()}catch{}});
  newTab.addEventListener("click",()=>{if(!activeGame)return;if(activePreparedHtml){const u=URL.createObjectURL(new Blob([activePreparedHtml],{type:"text/html;charset=utf-8"}));window.open(u,"_blank","noopener,noreferrer");setTimeout(()=>URL.revokeObjectURL(u),60000)}else if(activeSourceUrl)window.open(activeSourceUrl,"_blank","noopener,noreferrer")});
  downloadGame.addEventListener("click",()=>{if(!activeGame)return;if(activePreparedHtml){const u=URL.createObjectURL(new Blob([activePreparedHtml],{type:"text/html;charset=utf-8"}));const a=document.createElement("a");a.href=u;a.download=safeFileName(activeGame.name)+".html";document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),2000)}else if(activeSourceUrl){const a=document.createElement("a");a.href=activeSourceUrl;a.target="_blank";a.rel="noopener noreferrer";a.click()}});
  document.addEventListener("keydown",e=>{if(e.key!=="Escape")return;if(libraryMenu.classList.contains("open")||genreMenu.classList.contains("open"))closeMenus();else if(gameView.classList.contains("open")&&!document.fullscreenElement)closeGame()});

  async function init(){buildMenus();const settled=await Promise.allSettled([loadGnMath(),loadGeneric(SOURCES[1]),loadGeneric(SOURCES[2])]);const failed=[],all=[];settled.forEach((r,i)=>{if(r.status==="fulfilled")all.push(...r.value);else failed.push(SOURCES[i].name)});const seen=new Set();games=all.filter(g=>{const k=g.provider+":"+g.id;if(seen.has(k))return false;seen.add(k);return true});if(failed.length&&games.length){notice.textContent=(failed.length===1?failed[0]+" is":"Some libraries are")+" temporarily unavailable. The rest of VX Games is ready.";notice.classList.add("show")}else notice.classList.remove("show");render();LOG("Loaded",games.length,"games; GN-Math",games.filter(g=>g.provider==="gnmath").length)}
  init().catch(e=>{console.error(e);count.textContent="Unable to load games";grid.innerHTML='<div class="status">The game libraries could not be reached right now.</div>'});
})();
</script>
